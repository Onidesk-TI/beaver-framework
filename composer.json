{
    "name": "beaver/framework",
    "description": "Beaver Framework - Modern PHP Framework",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "beaver",
        "mvc"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Beaver\\": "src/",
            "App\\": "app/",
            "Beaver\\Sdk\\": "sdk/src/",
            "Beaver\\Plugins\\Console\\": "plugins/console/src/",
            "Beaver\\Plugins\\Frankei\\": "plugins/frankei/src/",
            "Beaver\\Plugins\\Library\\": "plugins/library/src/",
            "Beaver\\Plugins\\Nav\\": "plugins/beaver-nav/src/",
            "Beaver\\Plugins\\Skeleton\\": "plugins/beaver-skeleton/src/",
            "Beaver\\Plugins\\SqlWizard\\": "plugins/sqlwizard/src/",
            "Beaver\\Plugins\\Tips\\": "plugins/tips/src/",
            "Beaver\\Plugins\\UpdateManager\\": "plugins/update-manager/src/",
            "Beaver\\Plugins\\BeaverAdmin\\": "plugins/beaver-admin/src/",
            "Beaver\\Plugins\\BeaverInstaller\\": "plugins/beaver-installer/src/"
        },
        "files": [
            "src/View/helpers.php"
        ]
    },
    "bin": [
        "beaver"
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
