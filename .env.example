# =============================================================
#  Beaver Framework — exemplo de .env
# =============================================================

# --- Aplicação ---
APP_NAME="Beaver Framework"
APP_ENV=local              # local | staging | production
APP_DEBUG=true             # false em produção
APP_URL=http://localhost:9000
APP_KEY=                   # chave de 32 bytes em base64 (segurança)
APP_TIMEZONE=Europe/Lisbon




# --- Base de dados (quando o Bloco 4 estiver pronto) ---
DB_DRIVER=sqlite           # sqlite | mysql | pgsql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beaver
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Driver de datas dos casts do Model.
# 'beaver' → \DateTimeImmutable nativo (default, sem dependências)
# 'carbon' → Carbon\CarbonImmutable (requer: composer require nesbot/carbon)
BEAVER_DATE_DRIVER=beaver


# --- Plugins ---
# de onde os plugins são carregados:
#   dev     → beaver-plugins/ (fora do framework) + staging + prod
#   staging → staging_path + prod
#   prod    → apenas app/plugins/ dentro do framework
BEAVER_PLUGIN_MODE=dev



# --- SMS Provider (plugin sms) ---
# Fornecedor de SMS configurável. Os valores de exemplo abaixo
# são da EZ4U, que foi o primeiro fornecedor suportado.
#
# Os nomes SMS_PROVIDER_* são genéricos de propósito. Se um dia
# trocares para outro fornecedor, mudas o URL e (se necessário)
# adaptas o SmsService::cUrl() — o resto do plugin não muda.
SMS_PROVIDER_URL=
SMS_PROVIDER_ACCOUNT=
SMS_PROVIDER_KEY=          # licensekey da API (NÃO é a password do dashboard)
SMS_PROVIDER_SENDER=Onidesk
SMS_PROVIDER_ENVIO24=1
SMS_PROVIDER_TTL=24