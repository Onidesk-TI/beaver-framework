# =============================================================
#  Beaver — variáveis de ambiente
# =============================================================

# --- Aplicação ---
APP_NAME="{{ APP_NAME }}"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:9000
APP_KEY=
APP_TIMEZONE=Europe/Lisbon
APP_LOCALE=pt_PT

# --- Base de dados ---
DB_DRIVER=sqlite
DB_DATABASE=storage/database.sqlite
# Para MySQL/PostgreSQL, descomenta e preenche:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME={{ APP_SLUG }}
# DB_USER=root
# DB_PASS=
# DB_CHARSET=utf8mb4

# --- Plugins ---
BEAVER_PLUGIN_MODE=prod
BEAVER_PERMISSIONS_MODE=audit

# --- Datas ---
BEAVER_DATE_DRIVER=beaver

# --- Idiomas ---
BEAVER_LANG=pt
