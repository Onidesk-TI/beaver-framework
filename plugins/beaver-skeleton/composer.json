{
    "name": "onidesk/beaver-console",
    "description": "Beaver Skeleton — esqueleto oficial para criar plugins Beaver",
    "type": "beaver-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Beaver\\Plugins\\Skeleton\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Beaver\\Plugins\\Skeleton\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Stubs/"
        ]
    }
}