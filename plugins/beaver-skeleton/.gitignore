# ============================================================
#  Beaver Skeleton — .gitignore
# ============================================================

# ---- Composer ---------------------------------------------
/vendor/
composer.lock

# ---- PHP --------------------------------------------------
*.log
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpstan.cache
.psalm/
build/
coverage/

# ---- Testes / relatórios ----------------------------------
/reports/
/test-results.txt
/junit.xml
/coverage/
/clover.xml
/coverage.xml
*.cov

# ---- IDE / Editor -----------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/
.buildpath

# ---- Sistema operativo ------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Build / dist -----------------------------------------
/dist/
/build/
/out/
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# ---- Local config -----------------------------------------
# Mantém apenas o exemplo
.env
.env.*
!.env.example
!.env.testing
config/local.php
config/*.local.php

# ---- Cache / temporários ----------------------------------
/tmp/
/var/cache/
/var/log/
*.cache
*.pid
*.seed
*.bak
*.orig
*.rej

# ---- Node (caso uses bundler) -----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
.vite/
.parcel-cache/

# ---- Docker (opcional) ------------------------------------
docker-compose.override.yml
*.env.docker

# ---- Skeleton / dev local ---------------------------------
/scratch/
/playground/
*.local
