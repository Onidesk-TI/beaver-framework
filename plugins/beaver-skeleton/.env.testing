# ============================================================
#  Beaver Skeleton — .env.testing
#  Valores usados apenas em testes (phpunit).
#  Nunca usar em produção.
# ============================================================

# ---- Aplicação --------------------------------------------
APP_NAME="Beaver Skeleton [TEST]"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:9000

# ---- Plugin -----------------------------------------------
SKELETON_SLUG=skeleton
SKELETON_ENABLED=true
SKELETON_VERSION=0.1.0

# ---- Rotas -------------------------------------------------
SKELETON_ROUTE_PREFIX=/skeleton
SKELETON_ASSETS_PREFIX=/plugins/beaver-skeleton

# ---- Base de dados ----------------------------------------
# SQLite em memória — rápido e sem ficheiros no disco
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# ---- Log ---------------------------------------------------
# Em testes, o log vai para stderr para aparecer no PHPUnit
LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_FILE=php://stderr

# ---- Desenvolvimento --------------------------------------
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=9001

# ============================================================
#  NOTAS
# ============================================================
#
#  - Carregado automaticamente pelo PHPUnit se configurado.
#
#  - No phpunit.xml, adiciona:
#
#      <php>
#          <env name="APP_ENV" value="testing"/>
#          <env name="DB_DATABASE" value=":memory:"/>
#      </php>
#
#  - Ou carrega explicitamente no bootstrap dos testes:
#
#      (new Dotenv\Dotenv(__DIR__, '.env.testing'))->safeLoad();
#
#  - Nunca comitas um .env.testing com segredos reais. Este é
#    apenas um modelo com valores fictícios.
#
# ============================================================
