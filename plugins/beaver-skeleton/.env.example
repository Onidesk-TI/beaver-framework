# ============================================================
#  Beaver Skeleton — .env.example
#  Copia para .env e ajusta os valores.
# ============================================================

# ---- Aplicação --------------------------------------------
APP_NAME="Beaver Skeleton"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:9000

# ---- Plugin -----------------------------------------------
# Slug do plugin (tem de bater certo com plugin.json)
SKELETON_SLUG=skeleton
SKELETON_ENABLED=true
SKELETON_VERSION=0.1.0

# ---- Rotas -------------------------------------------------
# Prefixo das rotas do plugin
SKELETON_ROUTE_PREFIX=/skeleton

# ---- Assets ------------------------------------------------
# Prefixo público dos assets servidos pelo router
SKELETON_ASSETS_PREFIX=/plugins/beaver-skeleton

# ---- Base de dados (opcional, se o plugin usar PDO) -------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/onidesk/beaver-framework/database/beaver.sqlite

# Alternativa MySQL/MariaDB:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=beaver
# DB_USERNAME=beaver
# DB_PASSWORD=secret

# ---- Log ---------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_FILE=/tmp/beaver-skeleton.log

# ---- Desenvolvimento --------------------------------------
# Porta do servidor embutido do PHP
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=9000

# ============================================================
#  NOTAS
# ============================================================
#
#  1. Nunca comitas o .env real. Este ficheiro serve de modelo.
#
#  2. Cria o teu .env a partir deste:
#
#       cp .env.example .env
#       # edita o .env
#
#  3. O framework Beaver deve carregar o .env no bootstrap.
#     Se não carregar automaticamente, podes usar vlucas/phpdotenv:
#
#       composer require vlucas/phpdotenv
#
#     E no bootstrap:
#
#       $dotenv = Dotenv\Dotenv::createImmutable(__DIR__);
#       $dotenv->safeLoad();
#
#  4. Variáveis reservadas pela framework (não usar aqui):
#
#       APP_ENV, APP_DEBUG, APP_URL, APP_KEY
#
# ============================================================
